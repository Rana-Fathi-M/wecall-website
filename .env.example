# Copy this file to .env and paste your EmailJS IDs.
# Vite only reads .env — .env.example is ignored.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Public Calendly event URL. Admin sets available hours in Calendly.
# Booked times lock for every visitor. Canceled meetings reopen on the site.
VITE_CALENDLY_URL=https://calendly.com/your-handle/boardroom-session
